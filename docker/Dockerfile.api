# Dockerfile.api — Maize Leaf Classifier inference API
# Multi-stage: build tools and pip wheel cache excluded from runtime image
# Pattern: llama.cpp — venv built in builder, only /opt/venv copied to runtime

# Stage 1: Install all Python dependencies into an isolated venv
FROM python:3.11-slim AS builder

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Stage 2: Minimal runtime — no pip, no wheel cache, no build headers
FROM python:3.11-slim AS runtime

RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/bash --create-home appuser

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY api/ ./api/
COPY model/ ./model/

RUN mkdir -p /app/model_artifacts && chown appuser:appgroup /app/model_artifacts

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request, json, sys; \
        r = urllib.request.urlopen('http://localhost:8000/health', timeout=8); \
        d = json.loads(r.read()); \
        sys.exit(0 if d.get('status') == 'ok' else 1)"

EXPOSE 8000

ENTRYPOINT ["uvicorn", "api.main:app", \
    "--host", "0.0.0.0", \
    "--port", "8000", \
    "--workers", "1", \
    "--timeout-graceful-shutdown", "30"]
